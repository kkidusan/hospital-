generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ====================== ENUMS ======================

enum Role {
  ADMIN
  RECEPTION
  TRIAGE
  SPECIALIST
  LABORATORY
  RADIOLOGY
  BILLING
  FINANCIAL
  PHARMACIST
  INVENTORY
}

enum ServiceCategory {
  LABORATORY
  RADIOLOGY
  CONSULTATION
  INPATIENT
  PROCEDURE
  AMBULANCE
  PHARMACY
  OTHER
}

enum BillingMethod {
  FIXED
  PER_DAY
  HOURLY
  PACKAGE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
  REFUNDED
}

enum QueueStatus {
  WAITING
  IN_TRIAGE
  TRIAGED
  EMERGENCY
  MATERNITY // Added: Specific status for Labor/Maternity flow
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  ARRIVED
  CANCELLED
  COMPLETED
  NOSHOW
}

enum AppointmentType {
  INITIAL
  FOLLOW_UP
  REVIEW
  PROCEDURE
  OTHER
}

enum AppointmentPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum LabRequestStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum LabTestCategory {
  HEMATOLOGY
  SEROLOGY
  CHEMISTRY
  URINALYSIS
  MICROBIOLOGY
  HORMONAL
  COAGULATION
  OTHERS
}

enum RadiologyRequestStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum AdmissionSource {
  ER
  OPD
  LABOR_TRIAGE
}

enum WardType {
  ICU
  GENERAL
  PEDIATRICS
  MATERNITY
  SURGICAL
  MEDICAL
  EMERGENCY_TRIAGE
}

enum AdmissionStatus {
  ACTIVE
  TRANSFERRED
  DISCHARGED
  CANCELLED
}

enum DischargeType {
  RECOVERED
  REFERRED
  DAMA
  DECEASED
  OTHER
}

enum FollowUpCategory {
  RECALL
  CHRONIC_CARE
  POST_OP
  FOLLOW_UP
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  LAB_REQUEST
  RADIOLOGY_REQUEST
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAW_REQUESTED
  WITHDRAWN
}

// ====================== USER & AUTH ======================

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                Role      @default(RECEPTION)
  specialty           String?
  failedLoginAttempts Int       @default(0)
  lastFailedLogin     DateTime?
  currentSessionToken String?
  lastLoginAt         DateTime?
  lastLoginIP         String?
  lastLoginUserAgent  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  consultationsCreated     Consultation[]     @relation("ConsultationCreatedBy")
  labRequestsCreated       LabRequest[]       @relation("LabRequestCreatedBy")
  radiologyRequestsCreated RadiologyRequest[] @relation("RadiologyRequestCreatedBy")
  prescriptionsCreated     Prescription[]     @relation("PrescriptionCreatedBy")
  invoicesCreated          Invoice[]          @relation("InvoiceCreatedBy")
  radiologyReports         RadiologyRequest[] @relation("RadiologyReportedBy")
  auditLogs                AuditLog[]
  admittingAdmissions      Admission[]        @relation("AdmittingDoctor")
  appointmentsCreated      Appointment[]      @relation("AppointmentDoctor")
  notifications            Notification[]     @relation("UserNotifications")
  performedLabTests        LabRequestTest[]   @relation("PerformedBy")
  completedLabRequests     LabRequest[]       @relation("LabRequestCompletedBy")
  labResultNotifications   LabResultNotification[] @relation("LabResultNotifications")
  
  consultationDrafts       ConsultationDraft[] @relation("DoctorDrafts")

  // Added relation for Queue Assignment
  assignedQueues           Queue[]            @relation("DoctorQueue")

  @@map("users")
}

// ====================== PATIENT CORE ======================

model Patient {
  id             String    @id @default(cuid())
  mrn            String    @unique
  fullName       String
  age            Int
  ageUnit        String?   @default("years")
  sex            String?
  gender         String?
  dateOfBirth    DateTime?
  phoneNumber    String?   @unique
  email          String?
  address        String?
  region         String?   @default("Addis Ababa")
  zoneSubcity    String?
  woreda         String?
  emergencyName  String?
  emergencyPhone String?
  emergencyRel   String?
  lastDiagnosis  String?
  lastSummary    String?   @db.Text
  lastVisitDate  DateTime?
  registeredAt   DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  queue                  Queue?
  triage                 Triage[] 
  consultations          Consultation[]
  labRequests            LabRequest[]
  radiologyRequests      RadiologyRequest[]
  prescriptions          Prescription[]
  appointments           Appointment[]
  invoices               Invoice[]
  patientHistory         PatientHistory[]
  admissions             Admission[]
  labResultNotifications LabResultNotification[]
  
  consultationDrafts     ConsultationDraft[]

  @@index([mrn])
  @@index([phoneNumber])
  @@index([fullName])
  @@map("patients")
}

// ====================== CONSULTATION ======================

model Consultation {
  id              String    @id @default(cuid())
  patientId       String
  admissionId     String?
  createdById     String?
  
  vitals          Json?
  chiefComplaint  String?   
  clinicalNotes   String?   @db.Text
  
  diagnosis       String?   
  diagnoses       Json?     
  
  followUpDate    DateTime?
  followUpTime    String?
  followUpType    String?
  followUpReason  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission Admission? @relation("AdmissionConsultations", fields: [admissionId], references: [id])
  createdBy User?      @relation("ConsultationCreatedBy", fields: [createdById], references: [id])

  @@map("consultations")
}

model ConsultationDraft {
  id        String   @id @default(cuid())
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorId  String
  patientId String

  doctor  User  @relation("DoctorDrafts", fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([patientId])
  @@map("consultation_drafts")
}

// ====================== INVENTORY & LOGISTICS ======================

model Zone {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  status      String     @default("Active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  shelves  Shelf[]
  materials Material[]

  @@map("zones")
}

model Shelf {
  id        String   @id @default(cuid())
  code      String   @unique
  level     String   
  capacity  Int      @default(100)
  status    String   @default("Active")
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  
  materials Material[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@map("shelves")
}

model Material {
  id               String   @id @default(cuid())
  sku              String   @unique
  name             String
  category         String   
  
  qtyPerCarton     Int      @default(0) 
  qtyPerBox        Int      @default(0) 
  
  totalInBaseUnits Int      @default(0) 
  baseUnit         String   @default("Piece")
  
  zoneId           String?
  zone             Zone?    @relation(fields: [zoneId], references: [id])
  shelfId          String?
  shelf            Shelf?   @relation(fields: [shelfId], references: [id])
  
  minThreshold       Int      @default(10)
  maxQuotaPerRequest Int      @default(0)
  requiresApproval   Boolean  @default(false)
  
  expiryDate       DateTime?
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  withdrawals  MaterialWithdrawal[]

  @@index([zoneId])
  @@index([shelfId])
  @@map("materials")
}

model MaterialWithdrawal {
  id          String           @id @default(cuid())
  materialId  String
  requestedBy String
  department  String           @default("Laboratory")
  quantity    Int
  status      WithdrawalStatus @default(PENDING)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  material    Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_withdrawals")
}

// ====================== CLINICAL MODELS ======================

model LabRequest {
  id                 String           @id @default(cuid())
  patientId          String
  requestedById      String?
  requestedByName    String?
  clinicalIndication String?          @db.Text
  labNotes           String?          @db.Text
  status             LabRequestStatus @default(PENDING_PAYMENT)
  totalAmount        Float            @default(0)
  completedAt        DateTime?
  completedById      String?
  completedByName    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy        User?            @relation("LabRequestCreatedBy", fields: [requestedById], references: [id])
  completedBy        User?            @relation("LabRequestCompletedBy", fields: [completedById], references: [id])
  tests              LabRequestTest[]
  invoiceItems       InvoiceItem[]
  notifications      LabResultNotification[]

  @@index([patientId])
  @@map("lab_requests")
}

model LabRequestTest {
  id             String          @id @default(cuid())
  labRequestId   String
  testName       String
  category       LabTestCategory
  result         String?
  unit           String?
  referenceRange String?
  flag           String?
  remarks        String?         @db.Text
  performedAt    DateTime?
  performedBy    String?
  performedById  String?
  reportedAt     DateTime?

  labRequest      LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  performedByUser User?      @relation("PerformedBy", fields: [performedById], references: [id])

  @@map("lab_request_tests")
}

model RadiologyRequest {
  id               String                 @id @default(cuid())
  patientId        String
  requestedById    String?
  reportedById     String?
  requestedByName  String?
  clinicalData     String?                @db.Text
  xrayType         String?
  ultrasound       String[]               @default([])
  scanType         String?
  status           RadiologyRequestStatus @default(PENDING_PAYMENT)
  findings         String?                @db.Text
  impression       String?                @db.Text
  radiologistNotes String?                @db.Text
  reportedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy  User?         @relation("RadiologyRequestCreatedBy", fields: [requestedById], references: [id])
  reportedBy   User?         @relation("RadiologyReportedBy", fields: [reportedById], references: [id])
  invoiceItems InvoiceItem[]

  @@map("radiology_requests")
}

// ====================== INFRASTRUCTURE ======================

model Ward {
  id        String   @id @default(cuid())
  name      String   @unique
  type      WardType
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wards")
}

model Room {
  id         String   @id @default(cuid())
  roomNumber String
  isPrivate  Boolean  @default(false)
  wardId     String
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  beds       Bed[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([wardId, roomNumber])
  @@map("rooms")
}

model Bed {
  id         String      @id @default(cuid())
  bedNumber  String      @unique 
  roomId     String
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  isOccupied Boolean     @default(false)
  admissions Admission[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("beds")
}

model Admission {
  id                String          @id @default(cuid())
  patientId          String
  admissionDate      DateTime        @default(now())
  dischargeDate      DateTime?
  source             AdmissionSource @default(OPD)
  admittingDoctorId String?
  bedId              String?
  bed                Bed?            @relation(fields: [bedId], references: [id])
  status             AdmissionStatus @default(ACTIVE)
  dischargeType      DischargeType?
  dischargeSummary   String?         @db.Text
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admittingDoctor User?          @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  invoices         Invoice[]
  consultations   Consultation[] @relation("AdmissionConsultations")

  @@map("admissions")
}

model Triage {
  id              String   @id @default(cuid())
  patientId       String   
  temperature     Float?
  pulse           Int?
  respiratoryRate Int?
  bloodPressure   String?
  spo2            Int?
  weight          Float?
  chiefComplaint  String
  triageLevel     String   
  
  assessmentNotes String?  @db.Text 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("triages")
}

model Queue {
  id               String      @id @default(cuid())
  patientId        String      @unique
  visitId          String?     @unique 
  status           QueueStatus @default(WAITING)
  position         Int?
  
  // FIXED: Added assignedDoctorId and relation
  assignedDoctorId String?
  doctor           User?       @relation("DoctorQueue", fields: [assignedDoctorId], references: [id])

  enteredAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("queues")
}

// ====================== BILLING ======================

model ServiceDefinition {
  id            String          @id @default(cuid())
  name          String          @unique
  category      ServiceCategory
  billingMethod BillingMethod   @default(FIXED)
  basePrice     Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  priceHistory PriceHistory[]

  @@map("service_definitions")
}

model PriceHistory {
  id           String   @id @default(cuid())
  serviceId    String
  oldPrice     Float
  newPrice     Float
  changeReason String?
  changedAt    DateTime @default(now())

  service ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model Invoice {
  id                String        @id @default(cuid())
  patientId         String
  admissionId       String?
  createdById       String?
  subTotal          Float         @default(0)
  taxRate           Float         @default(0.15)
  taxAmount         Float         @default(0)
  totalAmount       Float         @default(0)
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  paidAt            DateTime?
  relatedRequestId  String?
  relatedRequestType String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission Admission?    @relation(fields: [admissionId], references: [id])
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id                  String          @id @default(cuid())
  invoiceId           String
  serviceName         String
  category            ServiceCategory
  quantity            Float           @default(1)
  total               Float
  isOverride          Boolean         @default(false)
  overrideReason      String?
  labRequestId        String?
  radiologyRequestId String?
  createdAt            DateTime        @default(now())

  invoice           Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  labRequest         LabRequest?       @relation(fields: [labRequestId], references: [id], onDelete: SetNull)
  radiologyRequest RadiologyRequest? @relation(fields: [radiologyRequestId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

// ====================== PHARMACY & APPOINTMENTS ======================

model Prescription {
  id             String   @id @default(cuid())
  patientId      String
  prescribedById String?
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  createdAt      DateTime @default(now())

  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedBy User?   @relation("PrescriptionCreatedBy", fields: [prescribedById], references: [id])

  @@map("prescriptions")
}

model Appointment {
  id                String              @id @default(cuid())
  patientId         String
  doctorId          String?
  doctorName        String?
  appointmentDate   DateTime
  reason            String?
  type              AppointmentType     @default(FOLLOW_UP)
  priority          AppointmentPriority @default(ROUTINE)
  status            AppointmentStatus   @default(SCHEDULED)
  notes             String?             @db.Text
  followUpCategory FollowUpCategory?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User?   @relation("AppointmentDoctor", fields: [doctorId], references: [id])

  @@map("appointments")
}

// ====================== SYSTEM UTILS ======================

model PatientSequence {
  id      String @id @default(cuid())
  loc     String
  year    Int
  month   Int
  lastSeq Int    @default(0)

  @@unique([loc, year, month])
  @@map("patient_sequences")
}

model PatientHistory {
  id              String   @id @default(cuid())
  patientId        String
  historyEntries  Json     @default("[]")
  latestDiagnosis String?
  latestNotes     String?  @db.Text
  archivedAt      DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_histories")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model LabResultNotification {
  id              String           @id @default(cuid())
  labRequestId    String
  patientId       String
  patientName     String
  mrn             String
  completedById   String
  completedByName String
  title           String
  message         String           @db.Text
  type            NotificationType @default(LAB_REQUEST)
  isRead          Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  labRequest LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user       User       @relation("LabResultNotifications", fields: [completedById], references: [id])

  @@map("lab_result_notifications")
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType @default(INFO)
  isRead        Boolean          @default(false)
  paymentStatus String?          @default("PENDING")
  relatedId     String?
  relatedType   String?
  createdAt     DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}