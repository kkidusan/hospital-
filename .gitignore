# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (Never commit these secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Massive local build installers & backups
*.tar
*.exe
allowance-system-app.tar
Biruh_Tech_HMS_Setup.exe

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Generated Client (keeps repo clean)
**/app/generated/prisma/